{
  "name": "design-brand-strategy",
  "version": "1.0.0",
  "private": true,
  "description": "Elena Vance — Designer & Brand Strategist. Editorial portfolio site built with Next.js 16, React 19, and Tailwind CSS 4.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "db:push": "bun scripts/db.ts db push --accept-data-loss",
    "db:generate": "bun scripts/db.ts generate",
    "db:migrate": "bun scripts/db.ts migrate dev",
    "db:reset": "bun scripts/db.ts migrate reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test --project=chromium",
    "e2e:all": "playwright test",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "lucide-react": "^1.45.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "allowScripts": {
    "prisma": true,
    "@prisma/client": true
  }
}
