# ---------------------------------------------------------------------------
# design-brand-strategy — environment template
#
# Copy to `.env` (git-ignored) and adjust per environment.
# Never put secrets in this file — it is committed to the repository.
# ---------------------------------------------------------------------------

# SQLite database URL used by Prisma (schema: prisma/schema.prisma).
#
# The recommended relative value below lands at db/custom.db in the repo
# root for EVERY consumer: the shared resolver `src/lib/wcc/db-url.ts`
# re-anchors any relative `file:` URL pointing at db/custom.db to an
# absolute repo-root path — used by the app runtime (src/lib/db.ts) and by
# the Prisma CLI wrapper (scripts/db.ts) that backs `bun run db:*`.
# Always run db commands through the wrapper: `bun run db:push`.
#
# An absolute file: URL also works (containers/deploys pass it through
# untouched). Beware: a DATABASE_URL exported by a parent shell/CI env (or
# a parent-directory .env, which bun auto-loads) overrides this file — the
# wrapper pins the resolved path so the CLI cannot drift from the runtime.
DATABASE_URL=file:../db/custom.db


# Canonical site URL for SEO — metadataBase, OG, sitemap, robots.
# Local dev: http://localhost:3000
# Live deploy: https://design-brand-strategy.jesspete.shop
# (car-care pattern: both vars set to live origin; NEXT_PUBLIC_ is inlined
#  at build and client-exposed, SITE_URL is server-only fallback —
#  src/data/site.ts reads NEXT_PUBLIC_SITE_URL ?? SITE_URL ?? localhost)
#
# Consumed by (src/data/site.ts → SITE.url):
#   - layout metadataBase → absolute Open Graph / Twitter card / canonical URLs
#   - sitemap.ts        → absolute <loc> entries (5 static + 8 project pages)
#   - robots.ts         → absolute Sitemap: reference
#
# NEXT_PUBLIC_* values are inlined at BUILD time, not request time — a
# production deploy must be rebuilt after changing this value.
#
# Falls back to http://localhost:3000 when unset (fine for local dev).
NEXT_PUBLIC_SITE_URL=https://design-brand-strategy.jesspete.shop
SITE_URL=https://design-brand-strategy.jesspete.shop

# ---------------------------------------------------------------------------
# Playwright e2e (optional — see playwright.config.ts; defaults shown)
# ---------------------------------------------------------------------------
# E2E_PORT=3002          # port for the `next start` webServer
# E2E_BASE_URL=          # full URL to reuse an already-running server
#                        # (CI: set to skip the managed webServer)
