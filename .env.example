# ---------------------------------------------------------------------------
# design-brand-strategy — environment template
#
# Copy to `.env` (git-ignored) and adjust per environment. The site has
# exactly ONE configuration knob by design; do not add secrets here — the
# contact API is stateless (no persistence layer, no third-party keys).
# ---------------------------------------------------------------------------

# Canonical site URL (no trailing slash).
#
# Consumed by (src/data/site.ts → SITE.url):
#   - layout metadataBase → absolute Open Graph / Twitter card / canonical URLs
#   - sitemap.ts        → absolute <loc> entries (5 static + 8 project pages)
#   - robots.ts         → absolute Sitemap: reference
#
# NEXT_PUBLIC_* values are inlined at BUILD time, not request time — a
# production deploy must be rebuilt after changing this value.
#
# Falls back to http://localhost:3000 when unset (fine for local dev).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
